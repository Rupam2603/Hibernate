<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- Standalone Fallback Database settings (H2 in MySQL compatibility mode) -->
        <property name="hibernate.connection.driver_class">org.h2.Driver</property>
        <property name="hibernate.connection.url">jdbc:h2:mem:hibernate_ecommerce;MODE=MySQL;DB_CLOSE_DELAY=-1;DATABASE_TO_LOWER=TRUE</property>
        <property name="hibernate.connection.username">sa</property>
        <property name="hibernate.connection.password"></property>

        <!-- Hibernate SQL dialect -->
        <property name="hibernate.dialect">org.hibernate.dialect.H2Dialect</property>

        <!-- Automatic schema generation -->
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- SQL output -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>
        <property name="hibernate.highlight_sql">true</property>

        <!-- Current Session Context -->
        <property name="hibernate.current_session_context_class">thread</property>

        <!-- Entity Mappings -->
        <mapping class="com.ecommerce.entity.Category"/>
        <mapping class="com.ecommerce.entity.Product"/>
        <mapping class="com.ecommerce.entity.Users"/>
        <mapping class="com.ecommerce.entity.Orders"/>
        <mapping class="com.ecommerce.entity.OrderDetails"/>
    </session-factory>
</hibernate-configuration>
